          "blocks": {
            "rich_text_rJPe4m": {
              "type": "rich-text",
              "settings": {
                "text": "<p>At COCHIC, we believe fashion can do more than just make you look good, it can bring people together, spark conversations, and most importantly, make a meaningful impact. That’s why we partnered with the <strong>Canadian Cancer Society</strong> on a very special initiative: <strong>The Daffodil Collection</strong>.</p>",
                "content_width": "sm"
              },
              "blocks": {}
            }
