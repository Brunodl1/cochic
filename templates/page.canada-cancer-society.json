          "blocks": {
            "dynamic_grid_heading_f7wGqE": {
              "type": "_dynamic-grid-heading",
              "settings": {
                "text": "<strong>100% of profit donated</strong> to breast cancer research",
                "show_text_vertically": false,
                "font_size_desktop": 4.5,
