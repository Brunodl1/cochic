              "blocks": {}
            },
            "rich_text_RdiV6Y": {
              "type": "rich-text",
              "settings": {
                "text": "<p>This collection was created to support those affected by breast cancer. We're proud to share that 100% of the profits from this collection go directly toward breast cancer research, helping to fund lifesaving advancements and bringing hope to those who need it most. At the heart of this collection is our <strong>patented Collar Extender, </strong>a small yet powerful accessory that allows people to feel comfortable and elegant in shirts, ties, or any snug-fitting clothing.</p>",
                "content_width": "sm"
              },
              "blocks": {}
            }
