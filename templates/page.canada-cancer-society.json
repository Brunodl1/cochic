          "blocks": {
            "rich_text_jHnyn6": {
              "type": "rich-text",
              "settings": {
                "text": "<p>We invite you to explore the <strong>Daffodil Collection</strong>. By doing so, you're not only adding comfort and elegance to your daily life, you're also supporting vital research and joining a community that believes in <strong>hope, strength, and connection</strong>. These pieces also make <strong>perfect gifts</strong> for anyone who values style with impact and giving back.</p><p>Together, let’s keep blooming, for ourselves, for each other, and for a brighter future.</p><p><strong>Explore the collection and make a difference.</strong></p>",
                "content_width": "sm"
              },
