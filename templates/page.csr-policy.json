    "rich_text_ep4mfH": {
      "type": "rich-text",
      "blocks": {
        "richtext_477KWB": {
          "type": "richtext",
          "settings": {
            "text": "<p>We offer an exclusive B2B catalog to our corporate clients and strategic partners, with preferential prices, customized products, as well as white-glove service from our team.</p><p>Whether you're looking for a personalized corporate gift or wish to sell patented COCHIC® products in your store, our range of customizable items can meet all your business needs.</p><p>We are proud to count among our most prestigious clients world-renowned partners such as The Ritz-Carlton Hotel, Chemise-Homme, Moores, etc.</p><p>Please note that we have already reduced the prices shown in the catalog (when you log in to the B2B section of our website) for our commercial clients and strategic partners.</p><p><strong>Regular orders</strong>: Please allow a delivery time of three weeks from the date of the order.</p><p><strong>Custom orders</strong>: All items in our store can be customized. Please consult this page for more information.</p><p><strong>Warranty</strong>:</p><p>COCHIC® extensions for shirts and pants are unique, patented accessories made without metal, that do not pinch and are more comfortable to wear.</p><p>Gloria International Inc. offers a 90-day manufacturing warranty upon presentation of proof of purchase. Shipping fees are the responsibility of the corporate client.</p><p>To become a COCHIC® vendor or partner, please contact: <a>sales@cochic.com</a></p>"
          }
        }
      },
