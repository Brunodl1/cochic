    "text_with_fixed_background_XXrtRa": {
      "type": "text-with-fixed-background",
      "blocks": {
        "content_G7Hiqa": {
          "type": "content",
          "settings": {
            "color_scheme": "scheme-1",
            "content_position": "md:place-self-center-end",
            "title": "<em><strong>Rice Straw</strong></em>",
            "content": "<p>Over 1 billion tons of rice straw are produced globally each year, much of it burned, polluting the air and harming the planet. At COCHIC, we repurpose <strong>1,802,667 rice straws</strong> into durable collar extenders, turning waste into value. Less burning, more meaning. One stalk at a time.<br/><br/>This sustainable choice transforms a major environmental challenge into a stylish solution, making fashion not just functional but planet-friendly.</p>",
            "indent_heading": false
          }
        }
      },
