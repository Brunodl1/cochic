    "text_with_fixed_background_iGApMA": {
      "type": "text-with-fixed-background",
      "blocks": {
        "content_pxWX8n": {
          "type": "content",
          "settings": {
            "color_scheme": "scheme-1",
            "content_position": "md:place-self-center-end",
            "title": "<em><strong>Coffee Grounds</strong></em>",
            "content": "<p><strong>Coffee grounds</strong>, typically discarded after brewing, possess unique qualities that make them an ideal material for sustainable fashion accessories. </p><p>Every day, 27,400 tonnes of coffee grounds are wasted worldwide. But not yours. By choosing our upcycled coffee fiber collar extenders, you turn waste into innovation and style. Each year, we repurpose the equivalent of<strong> 98,328 cups of coffee</strong>, giving new life to what would otherwise be thrown away.</p>",
            "indent_heading": false
          }
        }
      },
