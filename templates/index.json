    "timeline_Fd7AHK": {
      "type": "timeline",
      "blocks": {
        "item_AxdtGM": {
          "type": "item",
          "settings": {
            "image": "shopify://shop_images/9f8d6102-c0c6-47f5-8d5a-d97cf8e9d445_1.jpg",
            "label": "Canada Cancer Society",
            "subheading": "",
            "icon": "none",
            "icon_width": 32,
            "mobile_icon_width": 24,
            "title": "COCHIC® <em>Impact</em>",
            "heading_tag": "h3",
            "highlight_effect": "default",
            "content": "<p>COCHIC partnered with the Canadian Cancer Society to create a special <a href=\"/pages/the-daffodil-collection\" target=\"_blank\" title=\"The Daffodil Collection\">Daffodil Collar Extender Collection</a>, donating 100% of the profits to support cancer research and care. We also proudly sponsored the Cancer Run by providing food, beverages, and gift bags filled with our collar extenders and bandanas.</p>"
          }
        },
        "item_DKdaMK": {
          "type": "item",
          "disabled": true,
          "settings": {
            "image": "shopify://shop_images/159295579_195344105694944_8678534464049232991_n_17889506737963917.jpg",
            "label": "« Ça va bien aller »",
            "subheading": "",
            "icon": "none",
            "icon_width": 32,
            "mobile_icon_width": 24,
            "title": "COCHIC <em>Impact</em>",
            "heading_tag": "h3",
            "highlight_effect": "default",
            "content": "<p><em>\"Ça va bien aller\"; </em>things will go well! We’ve created this collar and cuff extenders set in solidarity with the Quebec movement that started during the pandemic. With COCHIC, we promote diversity and social responsibility.</p>"
          }
        },
        "item_jb4xXE": {
          "type": "item",
          "settings": {
            "image": "shopify://shop_images/draft_3.png",
            "label": "eCOCHIC",
            "subheading": "",
            "icon": "none",
            "icon_width": 32,
            "mobile_icon_width": 24,
            "title": "COCHIC® <em>Impact</em>",
            "heading_tag": "h3",
            "highlight_effect": "default",
            "content": "<p>Our <a href=\"/collections/upcycled-collar-extenders\" target=\"_blank\" title=\"UPCYCLED EXTENDERS\">Upcycled Collection</a> reflects our commitment to sustainability by using eco-friendly materials in every piece. As a company, we’re striving for 100% sustainable environment, by caring in our own thoughtful and responsible way.</p>"
          }
        }
      },
